# LAVA credentials — required
LAVA_URL=https://lava.example.org
LAVA_TOKEN=<paste-token-here>

# ─────────────────────────────────────────────────────────────
# Model selection (LiteLLM syntax: <provider>/<model>)
# ─────────────────────────────────────────────────────────────
# Any LiteLLM-supported provider works. Pick one and set the matching
# key below; leave the others commented out.

# Anthropic direct:
TRIAGE_MODEL_DEFAULT=anthropic/claude-4-5-sonnet
ANTHROPIC_API_KEY=<paste-key-here>

# OpenAI:
# TRIAGE_MODEL_DEFAULT=openai/gpt-4o
# OPENAI_API_KEY=<key>

# OpenAI-compatible proxy / gateway (Azure OpenAI, internal gateway, etc.):
# keep the openai/* prefix and point OPENAI_API_BASE at the proxy.
# TRIAGE_MODEL_DEFAULT=openai/<model-name-passed-verbatim>
# OPENAI_API_BASE=https://<proxy-host>/v1
# OPENAI_API_KEY=<proxy-token>

# Google Gemini:
# TRIAGE_MODEL_DEFAULT=gemini/gemini-1.5-pro
# GOOGLE_API_KEY=<key>

# Local Ollama:
# TRIAGE_MODEL_DEFAULT=ollama/llama3.1:70b
# OLLAMA_API_BASE=http://ollama:11434

# ─────────────────────────────────────────────────────────────
# Outbound TLS
# ─────────────────────────────────────────────────────────────
# On corporate networks that intercept outbound TLS with a self-signed
# CA, point this at the CA PEM so httpx / requests both trust it:
# TRIAGE_LLM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Or, as a last resort, disable verification:
# TRIAGE_LLM_SSL_VERIFY=false

# ─────────────────────────────────────────────────────────────
# Optional service tuning (defaults shown)
# ─────────────────────────────────────────────────────────────
# TRIAGE_SKILL_DIR=./skills/kernel-triage
# TRIAGE_WORKSPACE_ROOT=./runs
# TRIAGE_REPORT_DIR=./reports
# TRIAGE_MAX_ITERATIONS=40
# TRIAGE_RUN_TIMEOUT_SEC=1800
# TRIAGE_MAX_WORKERS=1
# TRIAGE_MAX_ACTIVE_RUNS=16
# TRIAGE_LAVA_LOG_MAX_BYTES=104857600
# TRIAGE_HOST=0.0.0.0
# TRIAGE_PORT=8080
